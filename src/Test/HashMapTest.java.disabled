import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import pl.edu.pw.ee.aisd2025zex5.HashMap;


import java.io.ByteArrayOutputStream;
import java.util.Random;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertNotNull;

public class HashMapTest
{
    HashMap hm;
    byte [][] code;
    byte [][] huffman_code;
    int length = 3;
    int elem = 5;
    Random rand;

    @BeforeEach
    public void setUp() {
        hm = new HashMap(4999);
        rand =  new Random(337609);

        code = new byte [elem][length];
        huffman_code = new byte[elem][length];

        for(int i = 0; i < elem; i++) {
            for(int j = 0; j < length; j++) {
                code[i][j] = (byte)rand.nextInt();
                huffman_code[i][j] = (byte)rand.nextInt();
            }
        }
    }

    @Test
    public void incrementAndGetCounterTest()
    {
        int [] counter = new int [elem];

        for(int i = 0; i < elem; i++) {
            counter[i] = rand.nextInt(50);
        }

        for(int i = 0; i < elem; i++) {
            for(int j = 0; j < counter[i]; j++) {
                hm.incrementCounter(code[i]);
            }
        }

        for(int i = 0; i < elem; i++) {
            assertEquals(hm.getCounter(code[i]), counter[i]);
        }
    }

    @Test
    public void putAndGetCounterTest()
    {
        for(int i = 0; i < elem; i++) {
            hm.incrementCounter(code[i]);
            hm.putCode(code[i], huffman_code[i]);
            assertEquals(hm.getHuffmanCode(code[i]), huffman_code[i]);
        }
    }


}
